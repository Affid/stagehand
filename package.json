{
  "name": "module-library-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "typecheck": "pnpm --recursive --if-present run typecheck && tsc --noEmit -p scripts && tsc --noEmit -p .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:foundry": "playwright test -c playwright.foundry.config.ts",
    "test:foundry:app": "ML_TARGET=app playwright test -c playwright.foundry.config.ts",
    "foundry:start": "scripts/foundry/start.sh",
    "foundry:link": "node scripts/foundry/link-modules.ts",
    "foundry:setup": "node scripts/foundry/setup-world.ts",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build",
    "android:build": "pnpm build && node scripts/android/gradle.ts assembleDebug assembleRelease",
    "android:test": "node scripts/android/gradle.ts testDebugUnitTest createDebugUnitTestCoverageReport && node scripts/android/coverage.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/chrome": "^0.1.4",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
