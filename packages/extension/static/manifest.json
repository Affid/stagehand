{
  "manifest_version": 3,
  "name": "Stagehand for Foundry VTT",
  "version": "0.2.0",
  "description": "Organise Foundry VTT modules on the Setup screen.",
  "permissions": ["storage", "scripting", "activeTab"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "Stagehand",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "module-library@spike.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
