# Copy to .env.local (untracked) and fill in. Never commit real values.

# Local Foundry VTT (scripts/foundry/*)
FOUNDRY_APP_DIR=~/foundry/vtt
FOUNDRY_DATA_DIR=~/foundry/data
FOUNDRY_PORT=30000
FOUNDRY_ADMIN_PASSWORD=

# Windows Chrome started with --remote-debugging-port (optional)
CHROME_CDP_URL=http://localhost:9222

# Android device suite (tests/android, Windows' adb reached from WSL):
# Windows' home folder as WSL sees it. The APK folder (st-apk) and adb
# (Android/Sdk/platform-tools/adb.exe) are found under it; ST_APK_DIR,
# ST_APK_WIN and ST_ADB override each one.
ST_WIN_HOME=/mnt/c/Users/<you>
