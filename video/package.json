{
  "name": "stagehand-promo-video",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "The Stagehand promo video, built in code (Remotion). Not part of the shipped packages.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Promo out/stagehand-promo.mp4",
    "render:b": "remotion render src/index.ts PromoB out/stagehand-promo-b.mp4 --props='{\"music\":\"b-sampled\"}'",
    "render:listing": "remotion render src/index.ts ListingLoop out/listing-loop.mp4",
    "render:listing-gif": "remotion render src/index.ts ListingGif out/listing-frames --sequence --image-format=png",
    "still": "remotion still src/index.ts Promo",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.542",
    "@remotion/google-fonts": "^4.0.542",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.542"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^6.0.3"
  }
}
